# Скопируй в .env.local и заполни значениями из Supabase: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Voicer API (voicer.mat3u.com) — озвучка голосами ElevenLabs.
# Нужен только для генерации MP3 локально, в рантайме приложение его не читает.
VOICER_API_KEY=your-voicer-key-here

# Аналитика читалки и админка /admin.
# service_role из Settings → API: обходит RLS, живёт ТОЛЬКО на сервере,
# в браузер не попадает (нет префикса NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Кому открыта админка /admin — email'ы через запятую.
ADMIN_EMAILS=you@example.com
