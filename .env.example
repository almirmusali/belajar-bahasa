# Скопируй в .env.local и заполни значениями из Supabase: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Voicer API (voicer.mat3u.com) — озвучка голосами ElevenLabs.
# Нужен только для генерации MP3 локально, в рантайме приложение его не читает.
VOICER_API_KEY=your-voicer-key-here