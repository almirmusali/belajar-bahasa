# Озвучка и обложки — это данные приложения, а не мусор сборки.
# Правило `*.mp3` выше добавлено общим шаблоном «подготовки к публикации»,
# но на этом проекте на MP3 держится вся озвучка словаря и читалки:
# без исключения новые файлы молча не попадали бы в коммит.
!public/audio/**
!public/reading/**
# Озвучка сказок — по одному MP3 на часть, попадает под общий `*.mp3` выше.
# Без этого исключения записи молча не уезжали бы в коммит, а на сайте
# просто не было бы плеера — ошибки при этом никакой.
!public/skazki/**
# ...кроме демо-нарезок для сравнения голосов: это временный материал,
# который создаёт `npm run audio:sample`. Строчка должна идти ПОСЛЕ
# исключения выше, иначе `!public/audio/**` втягивает их обратно.
public/audio/_samples/

# черновики конвейера
/.scratch
/data/audio-tasks.jsonl

# Иллюстрации книг: в репозиторий уезжают webp (~21 МБ), исходные PNG (~155 МБ)
# остаются локально — они пересоздаются из data/reading/illustrations/*.prompts.json
public/reading/kabut-di-lembang/*.png
public/reading/perahu-terakhir/*.png
public/reading/kabut-di-lembang.png
public/reading/perahu-terakhir.png

# Сказки: в репозиторий уезжают только webp — исходные PNG остаются локально,
# они пересоздаются из data/skazki/<slug>.prompts.json. Конвейер
# (scripts/run-skazki.sh) удаляет PNG сам, правило нужно на случай ручного
# прогона генератора без конвертации.
public/skazki/*/*.png

# Арт обложек до наложения названия: регенерируется из covers.json, в репозиторий
# уезжают только готовые обложки из public/skazki/.
data/skazki/*/art/
# ...но не пробы голосов: это временный материал для выбора тембра, как и
# public/audio/_samples. Строчка должна идти ПОСЛЕ `!public/skazki/**`.
public/skazki/*/audio/_samples/
